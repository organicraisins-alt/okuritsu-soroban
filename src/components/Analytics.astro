---
import { analyticsId } from '../../config/site.mjs';
import { analyticsBootstrap } from '../../config/analytics.mjs';
const id = analyticsId(import.meta.env.PUBLIC_GA_ID);
---

{id && (
  <>
    <script
      is:inline
      async
      src={`https://www.googletagmanager.com/gtag/js?id=${id}`}
    ></script>
    <script is:inline set:html={analyticsBootstrap(id)}></script>
  </>
)}
